# ---------------------------------------------------------------------------
# Namu Data Room — environment
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres. Provision from the Vercel dashboard:
#   Storage → Create Database → Neon
# Then run `vercel env pull .env.local` to fetch it automatically.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Vercel Blob, for the document files themselves.
#   Storage → Create Store → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Signs the session cookies. MUST be at least 32 characters and secret.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-32-plus-random-characters"

# The owner. This address can sign into /admin and receives activity alerts.
OWNER_EMAIL="mouhamad@namuai.org"

# The room's public URL. Used to build invite links and email buttons.
# Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://dataroom.namu-ai.org"

# ---------------------------------------------------------------------------
# Email (optional — the room works fully without it)
# Without a key, invite links can still be copied by hand from the admin
# console and admin sign-in codes are printed to the server logs.
# Get a key at resend.com, then verify your sending domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Namu Data Room <dataroom@namu-ai.org>"
